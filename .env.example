# Zemprolabs Production Environment Configuration Example
# Copy this file to .env.local for local overrides.
# NOTE: Never commit sensitive private credentials or secrets here.

# Public Contact Form Gateway Endpoint (Optional)
# If provided, submissions from the Contact page and Project Estimation flow
# are POSTed directly to this URL as JSON. Point this at the first-party
# /api/contact function below to send real email via Resend.
# If unset or empty, or if the request fails, the application gracefully
# falls back to direct email (info@zemprolabs.com) and WhatsApp
# (+91 744 755 7577) client-side dispatch options.
VITE_CONTACT_ENDPOINT="/api/contact"

# --- Server-side only (never prefixed with VITE_, never sent to the browser) ---
# Used by api/contact.ts. Set these in Vercel Project Settings -> Environment
# Variables for production/preview, and in a local .env.local (gitignored) for
# `vercel dev`. Plain `vite dev`/`npm run dev` does NOT run this function --
# use `vercel dev` or a Vercel deployment to actually test real sending.

# Your Resend API key (https://resend.com -> API Keys). Required.
RESEND_API_KEY=""

# Verified sender identity, e.g. "Zemprolabs <noreply@zemprolabs.com>".
# Optional -- until you verify your own domain in Resend, leave this unset to
# use Resend's shared test sender (onboarding@resend.dev), which can only
# deliver to the email address on your own Resend account.
RESEND_FROM_EMAIL=""

# Inbox that receives submissions. Optional, defaults to info@zemprolabs.com.
CONTACT_TO_EMAIL=""
